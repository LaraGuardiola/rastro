{
  "name": "rastro",
  "version": "0.1.0",
  "private": true,
  "description": "Grabador y reproductor visual de flujos web (formularios) como extensión de Chrome. Motor propio, sin Puppeteer.",
  "type": "module",
  "scripts": {
    "build": "bun build.ts",
    "watch": "bun build.ts --watch",
    "typecheck": "tsc --noEmit",
    "demo": "bun demo/serve.ts",
    "zip": "bun build.ts && cd dist && zip -qr ../rastro.zip ."
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "typescript": "^5.6.3"
  }
}
